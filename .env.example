BOT_TOKEN=123456:ABC-DEF...
OPENROUTER_API_KEY=sk-or-...
# telegram user ids allowed to use the bot, comma-separated
ALLOWED_USER_IDS=111111111

LLM_MODEL=anthropic/claude-haiku-5.5
IMAGE_MODEL=krea/k3-edit
# generation resolution: 1K | 2K (falls back to 1K if the model rejects it)
IMAGE_RESOLUTION=2K
DEFAULT_VARIANTS=4
MAX_VARIANTS=8
DAILY_IMAGE_LIMIT=60

# STT: local (faster-whisper, needs ffmpeg) | cloud (OpenRouter /audio/transcriptions)
STT_PROVIDER=cloud
STT_MODEL=mistralai/voxtral-small-transcribe-3-0
WHISPER_MODEL_SIZE=small
MAX_VOICE_SECONDS=120

DATA_DIR=data
